SELECT
	tblPiese.Denumire_Piesa,
	tblProducator.Nume_Companie
FROM tblPiese JOIN tblProducator
ON tblPiese.id_Piesa= tblProducator.id_Piesa;

SELECT
	tblClient.Nume_Client,
	tblOfertare.Perioada
FROM tblClient JOIN tblOfertare
ON tblClient.Locatie= tblOfertare.Locatie;

SELECT
	tblPiese.Denumire_Piesa,
	tblOfertare.id_Oferta
FROM tblPiese JOIN tblOfertare
ON tblPiese.Cod_Piesa= tblOfertare.Cod_Piesa;

SELECT
	tblClient.Nume_Client,
	tblOfertare.Perioada
FROM tblClient JOIN tblOfertare
ON tblClient.id_Client= tblOfertare.id_Client;

SELECT AVG(Pret_Lucrare) AS Pret_Mediu
FROM tblOfertare;

SELECT
SUM(tblOfertare.Pret_Lucrare+(tblPiese.Pret_Piesa*tblPiese.Cantitate)) AS Pret_Total
FROM tblOfertare, tblPiese;

SELECT 
  SUM(tblOfertare.Pret_Lucrare+(tblPiese.Pret_Piesa*tblPiese.Cantitate)) AS Pret_Total
FROM tblOfertare
JOIN tblPiese
ON tblPiese.Cod_Piesa = tblOfertare.Cod_Piesa;

DROP TABLE tblClient;
DROP TABLE tblOfertare;
DROP TABLE tblPiese;
DROP TABLE tblProducator;
