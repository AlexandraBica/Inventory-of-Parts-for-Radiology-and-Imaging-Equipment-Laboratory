<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/alexb/OneDrive/Desktop/PCLP_tema.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1288"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="tblPiese" custom_title="0" dock_id="1" table="4,8:maintblPiese"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE tblPiese
(
id_Piesa NUMBER(3) PRIMARY KEY UNIQUE,
Cod_Piesa NUMBER(3),
Denumire_Piesa TEXT(30),
Pret_Piesa NUMBER(5),
Cantitate NUMBER(10)
);

CREATE TABLE tblProducator
(
id_Producator NUMBER(2) PRIMARY KEY NOT NULL UNIQUE,
Nume_Companie TEXT(30),
id_Piesa NUMBER(3),
Nr_telefon NUMBER(10),
Mail TEXT(30),
Adresa TEXT(25),
Site TEXT(25)
);

CREATE TABLE tblClient
(
id_Client NUMBER(3) PRIMARY KEY UNIQUE,
Nume_Client TEXT(15),
Prenume_Client TEXT(15),
CNP NUMBER(13),
Nr_telefon NUMBER(10),
Mail TEXT(30),
Problema TEXT(30),
Locatie TEXT(30)
);

CREATE TABLE tblOfertare
(
id_Oferta NUMBER(3) PRIMARY KEY UNIQUE,
id_Client NUMBER(3),
Cod_Piesa NUMBER(3),
id_Producator NUMBER(3),
Perioada DATE(10),
Locatie TEXT(30),
Pret_Lucrare NUMBER(6)
);


